# ============================================
# 家庭健康飲食 AI - 環境變數設定範例
# ============================================
# 請複製此檔案為 .env，並填入你的 API 金鑰
# 指令：cp .env.example .env
# ============================================

# 選擇要使用的 AI 服務：gemini | openai | xai
AI_PROVIDER=gemini

# ---------- Google Gemini（推薦新手，有免費額度）----------
# 取得方式：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=你的_Gemini_API_金鑰

# ---------- OpenAI（需付費）----------
# 取得方式：https://platform.openai.com/api-keys
OPENAI_API_KEY=你的_OpenAI_API_金鑰
OPENAI_MODEL=gpt-4o-mini

# ---------- xAI Grok（需付費）----------
# 取得方式：https://console.x.ai/
XAI_API_KEY=你的_xAI_API_金鑰
XAI_MODEL=grok-3-mini

# 伺服器埠號（通常不用改）
PORT=3000
